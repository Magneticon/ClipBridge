<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- v4: peer-to-peer automatic discovery. TCP and UDP both use port 5440. -->
    <add key="Port" value="8080" />
    <add key="AutoDiscovery" value="true" />
    <add key="DiscoveryIntervalMilliseconds" value="2000" />

    <!-- A PC may belong to any number of groups. Format: GroupName:GroupKey;OtherName:OtherKey -->
    <!-- Every local copy is announced to ALL groups listed here. Use the same name/key on machines that should share a clipboard. -->
    <add key="Groups" value="Main:ClipBridge-Change-Me" />

    <!-- Background operation. Windows autostart uses /silent. ShowTrayIcon can be disabled for completely invisible background operation. -->
    <add key="Silent" value="true" />
    <add key="ShowTrayIcon" value="true" />
    <add key="StartWithWindows" value="false" />

    <add key="SyncText" value="true" />
    <add key="SyncImages" value="true" />
    <add key="SyncFiles" value="true" />
    <add key="PollMilliseconds" value="250" />
    <add key="MaxImageMegabytes" value="100" />
    <add key="RemoteRequestTimeoutMilliseconds" value="15000" />
    <add key="MaxManifestEntries" value="200000" />
    <add key="FileReadChunkKilobytes" value="1024" />
    <add key="FileSessionRetentionMinutes" value="1440" />
  </appSettings>
</configuration>
